# --- Source store ---
SOURCE_STORE=example-source.myshopify.com
# Admin API access token（shpat_ / shpca_ / shpua_ …）
SOURCE_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Target store ---
TARGET_STORE=example-target.myshopify.com
TARGET_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Admin API 版本
SHOPIFY_API_VERSION=2025-01

# 可选：每次 mutation 之间的延迟（毫秒），避免触发限流
MUTATION_DELAY_MS=200

# 可选：Template 图片/视频同步时的默认 templates 目录（本机绝对路径）
# TEMPLATES_DIR=E:\MyTheme\templates

# 字段说明：
# - 统一使用 SOURCE_ACCESS_TOKEN / TARGET_ACCESS_TOKEN
# - 旧别名 SOURCE_TOKEN / TARGET_TOKEN 仍可被 CLI 识别，但建议迁移到 *_ACCESS_TOKEN
# - 同步台店铺配置同样只使用 Admin API access token

# Custom App 建议 scopes（按同步内容勾选）:
# - read_content, write_content          # Blog / Article / Page
# - read_products, write_products        # Product / Collection
# - read_files, write_files              # 图片视频 Files；Metaobject 条目里的图片/附件也需要
# - read_online_store_navigation, write_online_store_navigation  # Menu
# - read_metaobject_definitions, write_metaobject_definitions
# - read_metafield_definitions, write_metafield_definitions
# - read_metaobjects, write_metaobjects  # Metaobject 实例数据
