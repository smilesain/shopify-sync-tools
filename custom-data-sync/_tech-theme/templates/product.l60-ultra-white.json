    "common_spec_NXYNJE": {
      "type": "common-spec",
      "name": "Common spec",
      "settings": {
        "enable_common_width": false,
        "section_css": "matrix10-pro-spec  bg-white",
        "section_css_html": "",
        "bg_color": "#ffffff",
        "layout": "right",
        "section_title": "",
        "product_title": "",
        "content2": "",
        "content": "<div class=\"common-title title-box\">Specifications</div>\n<div class=\"spect-img spect-pc-img common-small--hide\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0302/5276/1220/files/l60-ultra-white-pc-62.webp?v=1782445711\" class=\"spect-img-left\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0302/5276/1220/files/l60-ultra-white-pc-63.webp?v=1782445727\" class=\"spect-img-right\">\n</div>\n<div class=\"spect-img common-pc--hide\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0302/5276/1220/files/l60-ultra-white-m-63.webp?v=1782445742\" class=\"spect-img-right\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0302/5276/1220/files/l60-ultra-white-m-62.webp?v=1782445738\" class=\"spect-img-right\">\n</div>",
        "show_first_content": "<div class=\"common-subtitle common-small--hide\">\n    <li>\n        <span>Product Name </span>\n        <span>L60 Ultra</span>\n    </li>\n    <li>\n        <span>Robot Vacuum Dimensions </span>\n        <span>351mm x 351mm x 89mm (VersaLift Sensor Retracted)<br> 351mm x 351mm x 111mm (VersaLift Sensor Raised)</span>\n    </li>\n    <li>\n        <span>Base Station Dimensions </span>\n        <span>340.4mm x 456.6mm x 589mm</span>\n    </li>\n    <li>\n        <span>Base Station Weight </span>\n        <span>9.14kg</span>\n    </li>\n    <li>\n        <span>Robot Vacuum Weight </span>\n        <span>4.01kg</span>\n    </li>\n    <li>\n        <span>Obstacle Crossing Height </span>\n        <span>40mm (Double-layer step); <br>22mm (Single-layer step)</span>\n    </li>\n    <li>\n        <span>Navigation </span>\n        <span>Retractable LDS</span>\n    </li>\n    <li>\n        <span>Main Brush Type </span>\n        <span>HyperStream Detangling DuoBrush</span>\n    </li>\n    <li>\n        <span>Obstacle Avoidance </span>\n        <span>AI Camera x2 + Lateral 3D Structured Light + LED</span>\n    </li>\n    <li>\n        <span>Maximum Suction </span>\n        <span>35,000Pa</span>\n    </li>\n</div>\n<div class=\"common-subtitle common-pc--hide\">\n    <li>\n        <span>Product Name </span>\n        <span>L60 Ultra</span>\n    </li>\n    <li>\n        <span>Robot Vacuum Dimensions </span>\n        <span>351mm x 351mm x 89mm <br>(VersaLift Sensor Retracted)<br> 351mm x 351mm x 111mm <br>(VersaLift Sensor Raised)</span>\n    </li>\n    <li>\n        <span>Base Station Dimensions </span>\n        <span>340.4mm x 456.6mm x 589mm</span>\n    </li>\n    <li>\n        <span>Base Station Weight </span>\n        <span>9.14kg</span>\n    </li>\n</div>",
        "show_more_content": "<div class=\"common-subtitle common-small--hide\">\n    <li>\n        <span>Brush Lifting </span><span>✓</span>\n    </li>\n    <li>\n        <span>Liftable Side Brush</span><span>x</span>\n    </li>\n    <li>\n        <span>Extendable Side Brush</span><span>✓</span>\n    </li>\n    <li>\n        <span>Mop Material</span><span>Regular Mop Pad</span>\n    </li>\n    <li>\n        <span>Mop Extending</span><span>✓</span>\n    </li>\n    <li>\n        <span>Mop Lifting</span><span>10.5mm</span>\n    </li>\n    <li>\n        <span>Battery Capacity</span><span>5,200mAh</span>\n    </li>\n    <li>\n        <span>Dust Box Capacity</span><span>365ml</span>\n    </li>\n    <li>\n        <span>Clean/Waste Water Tank Capacity</span><span>4.5L/4.0L</span>\n    </li>\n    <!-- <li>\n        <span>Voice Control</span><span>Direct, Third-Party</span>\n    </li> -->\n    <li>\n        <span>Auto Mop Cleaning with Hot Water</span><span>✓ (ThermoHub 100°C Mop Self-Cleaning)</span>\n    </li>\n    <li>\n        <span>Hot Air Drying</span><span>✓</span>\n    </li>\n    <li>\n        <span>Dirt Detection/Mop Rewashing and Floor Remopping</span><span>✓</span>\n    </li>\n    <li>\n        <span>Self-Cleaning Washboard</span><span>✓ (AceClean DryBoard)</span>\n    </li>\n    <li>\n        <span>Auto Solution Refilling</span><span>✓ (Single Compartment)</span>\n    </li>\n    <li>\n        <span>Auto Emptying</span><span>✓ (100 Days)</span>\n    </li>\n    <li>\n        <span>Bacteria Removal Technology</span><span>x</span>\n    </li>\n</div>\n<div class=\"common-subtitle common-pc--hide\">\n    <li>\n        <span>Robot Vacuum Weight </span>\n        <span>4.01kg</span>\n    </li>\n    <li>\n        <span>Obstacle Crossing Height </span>\n        <span>40mm (Double-layer step) <br>22mm (Single-layer step)</span>\n    </li>\n    <li>\n        <span>Navigation </span>\n        <span>Retractable LDS</span>\n    </li>\n    <li>\n        <span>Main Brush Type </span>\n        <span>HyperStream Detangling DuoBrush</span>\n    </li>\n    <li>\n        <span>Obstacle Avoidance </span>\n        <span>AI Camera x2 + Lateral 3D Structured Light + LED</span>\n    </li>\n    <li>\n        <span>Maximum Suction </span>\n        <span>35,000Pa</span>\n    </li>\n    <li>\n        <span>Brush Lifting </span><span>✓</span>\n    </li>\n    <li>\n        <span>Liftable Side Brush</span><span>x</span>\n    </li>\n    <li>\n        <span>Extendable Side Brush</span><span>✓</span>\n    </li>\n    <li>\n        <span>Mop Material</span><span>Regular Mop Pad</span>\n    </li>\n    <li>\n        <span>Mop Extending</span><span>✓</span>\n    </li>\n    <li>\n        <span>Mop Lifting</span><span>10.5mm</span>\n    </li>\n    <li>\n        <span>Battery Capacity</span><span>5,200mAh</span>\n    </li>\n    <li>\n        <span>Dust Box Capacity</span><span>365ml</span>\n    </li>\n    <li>\n        <span>Clean/Waste Water Tank Capacity</span><span>4.5L/4.0L</span>\n    </li>\n    <!-- <li>\n        <span>Voice Control</span><span>Direct, Third-Party</span>\n    </li> -->\n    <li>\n        <span>Auto Mop Cleaning with Hot Water</span><span>✓ (ThermoHub 100°C Mop Self-Cleaning)</span>\n    </li>\n    <li>\n        <span>Hot Air Drying</span><span>✓</span>\n    </li>\n    <li>\n        <span>Dirt Detection/Mop Rewashing and Floor Remopping</span><span>✓</span>\n    </li>\n    <li>\n        <span>Self-Cleaning Washboard</span><span>✓ (AceClean DryBoard)</span>\n    </li>\n    <li>\n        <span>Auto Solution Refilling</span><span>✓ (Single Compartment)</span>\n    </li>\n    <li>\n        <span>Auto Emptying</span><span>✓ (100 Days)</span>\n    </li>\n    <li>\n        <span>Bacteria Removal Technology</span><span>x</span>\n    </li>\n</div>",
